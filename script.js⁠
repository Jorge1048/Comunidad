// --- PARSER DE ARCHIVOS MEJORADO Y TOLERANTE ---
function parseFilename(filename) {
    const nameWithoutExt = filename.replace(/\.pdf$/i, '').trim();
    let mangaName = '';
    let start = null;
    let end = null;
    let isRecognized = false;

    // Normalizar espacios y guiones bajos
    const normalized = nameWithoutExt
        .replace(/[_]+/g, ' ')
        .replace(/\s+/g, ' ')
        .trim();

    // 1. Buscar rangos estándar o con etiquetas (ej: Naruto 01-17, Naruto Cap 01-17, Naruto [01-17], Naruto 01 al 17)
    const rangeRegex = /^(.*?)\s*(?:cap(?:ítulo|itulo)?s?|chapter|chapters|ch|vol(?:umen)?|vol\.?)?\s*[\(\[]?\s*(\d+(?:\.\d+)?)\s*(?:-\vert{}–\vert{}—\vert{}al\vert{}a\vert{}to)\s*(\d+(?:\.\d+)?)\s*[\)\]]?\s*$/i;
    let match = normalized.match(rangeRegex);

    if (match) {
        mangaName = match[1].trim();
        start = parseFloat(match[2]);
        end = parseFloat(match[3]);
        isRecognized = true;
    }

    // 2. Buscar capítulo individual (ej: Naruto 53, Naruto Cap 53)
    if (!match) {
        const singleRegex = /^(.*?)\s*(?:cap(?:ítulo|itulo)?s?|chapter|ch|vol(?:umen)?|vol\.?)?\s*[\(\[]?\s*(\d+(?:\.\d+)?)\s*[\)\]]?\s*$/i;
        match = normalized.match(singleRegex);
        if (match) {
            mangaName = match[1].trim();
            start = parseFloat(match[2]);
            end = start;
            isRecognized = true;
        }
    }

    // 3. Caso alternativo: Número al principio (ej: 01-17 Naruto)
    if (!match) {
        const beginningRangeRegex = /^[\(\[]?\s*(\d+(?:\.\d+)?)\s*(?:-\vert{}–\vert{}—\vert{}al\vert{}a\vert{}to)\s*(\d+(?:\.\d+)?)\s*[\)\]]?\s*(.*?)$/i;         match = normalized.match(beginningRangeRegex);         if (match) {             start = parseFloat(match[1]);             end = parseFloat(match[2]);             mangaName = match[3].trim();             isRecognized = true;         }     }      // Limpieza final del nombre del manga     mangaName = mangaName         .replace(/[\(\)\[\]]/g, '')
        .replace(/\s+/g, ' ')
        .replace(/[-–—_:]+$/g, '')
        .trim();

    if (!mangaName) {
        mangaName = "Manga";
        isRecognized = false;
    }

    return {
        mangaName,
        start,
        end,
        isRecognized,
        cleanName: nameWithoutExt
    };
}

// --- ANÁLISIS INTELIGENTE CON NOMBRE DOMINANTE ---
function analyzeFiles(filesToAnalyze) {
    state.notifications = [];
    state.mangaTitleFallback = "Manga"; // Resetear siempre

    if (filesToAnalyze.length === 0) {
        state.mangaTitleFallback = "-";
        return;
    }

    // Contar ocurrencias de nombres detectados para encontrar el dominante
    const nameCounts = {};
    filesToAnalyze.forEach(file => {
        if (file.isRecognized && file.mangaName && file.mangaName !== "Manga") {
            const normalizedName = file.mangaName.replace(/\s+/g, ' ').trim();
            nameCounts[normalizedName] = (nameCounts[normalizedName] || 0) + 1;
        }
    });

    let dominantName = "Manga";
    let maxCount = 0;
    Object.entries(nameCounts).forEach(([name, count]) => {
        if (count > maxCount) {
            maxCount = count;
            dominantName = name;
        }
    });
    state.mangaTitleFallback = dominantName;

    // Ordenar numéricamente por capítulo inicial
    filesToAnalyze.sort((a, b) => {
        if (a.start === null && b.start === null) return 0;
        if (a.start === null) return 1;
        if (b.start === null) return -1;
        return a.start - b.start;
    });

    // Detectar duplicados y faltantes
    const seenChapters = new Set();
    filesToAnalyze.forEach((file, index) => {
        if (!file.isRecognized) {
            state.notifications.push({
                type: 'warning',
                title: 'Archivo no reconocido',
                text: `No se pudo identificar el capítulo de "${file.name}".`
            });
            return;
        }

        // Verificar duplicados por rango exacto
        const rangeKey = `${file.start}-${file.end}`;
        if (seenChapters.has(rangeKey)) {
            state.notifications.push({
                type: 'warning',
                title: 'Posible duplicado',
                text: `Se encontraron dos archivos que parecen contener los capítulos ${rangeKey}.`
            });
            file.status = 'warning';
        } else {
            seenChapters.add(rangeKey);
            file.status = 'ok';
        }

        // Verificar saltos / capítulos faltantes con el archivo anterior
        if (index > 0) {
            const prevFile = filesToAnalyze[index - 1];
            if (prevFile.end !== null && file.start !== null) {
                if (file.start > prevFile.end + 1) {
                    state.notifications.push({
                        type: 'info',
                        title: 'Capítulos faltantes',
                        text: `Se detectó un posible salto entre el capítulo ${prevFile.end} y el ${file.start}.`
                    });
                }
            }
        }
    });

    // Calcular estadísticas globales
    state.totalFiles = filesToAnalyze.length;
    state.totalSize = filesToAnalyze.reduce((acc, f) => acc + f.size, 0);
    
    const validStarts = filesToAnalyze.map(f => f.start).filter(s => s !== null);
    const validEnds = filesToAnalyze.map(f => f.end).filter(e => e !== null);
    
    if (validStarts.length > 0 && validEnds.length > 0) {
        state.detectedChaptersRange = `${Math.min(...validStarts)} - ${Math.max(...validEnds)}`;
    } else {
        state.detectedChaptersRange = "Ninguno";
    }

    state.filesWithIssues = filesToAnalyze.filter(f => !f.isRecognized || f.status === 'warning').length;
}

// --- DESCARGA SEGURA COMPATIBLE CON MÓVILES (SAFARI / CHROME) ---
function downloadBlob(blob, filename) {
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = filename;
    document.body.appendChild(a);
    a.click();
    
    // Limpieza de memoria para evitar bloqueos en iOS/Safari
    setTimeout(() => {
        document.body.removeChild(a);
        URL.revokeObjectURL(url);
    }, 1000);
}
